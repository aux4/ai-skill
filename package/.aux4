{
  "scope": "aux4",
  "name": "ai-skill",
  "version": "1.0.1",
  "description": "Native skill framework for aux4 — author, discover, validate, and export agent skills",
  "license": "Apache-2.0",
  "tags": [
    "ai",
    "skill",
    "agent",
    "framework"
  ],
  "profiles": [
    {
      "name": "main",
      "commands": [
        {
          "name": "ai",
          "execute": [
            "profile:ai"
          ],
          "help": {
            "text": "Artificial Intelligence"
          }
        }
      ]
    },
    {
      "name": "ai",
      "commands": [
        {
          "name": "skill",
          "execute": [
            "profile:ai:skill"
          ],
          "help": {
            "text": "Author, validate, and export aux4 agent skills"
          }
        }
      ]
    },
    {
      "name": "ai:skill",
      "commands": [
        {
          "name": "list",
          "execute": [
            "sh ${packageDir}/lib/list-skills.sh"
          ],
          "help": {
            "text": "List installed native skills with their descriptions"
          }
        },
        {
          "name": "validate",
          "execute": [
            "sh ${packageDir}/lib/validate-skill.sh values(name)"
          ],
          "help": {
            "text": "Validate that a skill conforms to the native skill contract",
            "variables": [
              {
                "name": "name",
                "text": "The name of the skill to validate",
                "arg": true
              }
            ]
          }
        },
        {
          "name": "export",
          "execute": [
            "sh ${packageDir}/lib/export-skill.sh values(name, format, output)"
          ],
          "help": {
            "text": "Export a skill to an interop format (SKILL.md, AGENTS.md, or MCP)",
            "variables": [
              {
                "name": "name",
                "text": "The name of the skill to export",
                "arg": true
              },
              {
                "name": "format",
                "text": "The output format",
                "default": "skill",
                "options": [
                  "skill",
                  "agents",
                  "mcp"
                ]
              },
              {
                "name": "output",
                "text": "The file to write the export to (defaults to stdout)",
                "default": ""
              }
            ]
          }
        },
        {
          "name": "init",
          "execute": [
            "sh ${packageDir}/lib/init-skill.sh values(name)"
          ],
          "help": {
            "text": "Scaffold a new native skill in the current directory",
            "variables": [
              {
                "name": "name",
                "text": "The name of the skill to scaffold",
                "arg": true
              }
            ]
          }
        }
      ]
    }
  ]
}
